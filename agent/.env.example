# LiveKit Cloud project credentials (Settings > Keys in the LiveKit Cloud dashboard).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# JAW Hub API base URL (no trailing slash needed) and the bearer token the hub
# accepts for /api/agent/* requests.
JAW_API_URL=https://your-jaw-hub.vercel.app
JAW_AGENT_TOKEN=

# Optional overrides (LiveKit Inference model identifiers).
# JAW_STT_MODEL=deepgram/nova-3
# JAW_LLM_MODEL=google/gemini-3.8-flash
# JAW_TTS_MODEL=cartesia/sonic-3
# JAW_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
